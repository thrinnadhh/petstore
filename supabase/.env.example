# Supabase Edge Function secrets example.
# Create a real supabase/.env locally if needed, then run:
# npx supabase secrets set --env-file supabase/.env
#
# Do not commit supabase/.env. It is ignored by .gitignore.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_key_secret

# Optional. For mobile-only calls, "*" is acceptable at function level because
# auth is JWT-based, but set this to your web origin when browser calls are used.
ALLOWED_ORIGIN=*
