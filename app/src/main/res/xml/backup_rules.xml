<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup Security Rules (API 30 and below)
  Excludes the Room SQLite database from Google Drive auto-backup.
  The database contains sensitive PII (Aadhaar, PAN, bank details, orders)
  and must NOT be backed up to cloud storage.
  See: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Exclude entire Room database files from cloud backup -->
    <exclude domain="database" path="paws_database"/>
    <exclude domain="database" path="paws_database-shm"/>
    <exclude domain="database" path="paws_database-wal"/>
    <!-- Exclude all shared preferences (may contain session tokens) -->
    <exclude domain="sharedpref" path="."/>
</full-backup-content>
