# CI/build environment example for Android release builds.
# Keep real values in your CI secret store, not in this file.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx

# Release signing values used by app/build.gradle.kts.
KEYSTORE_PATH=/secure/path/to/upload-keystore.jks
STORE_PASSWORD=your_keystore_store_password
KEY_PASSWORD=your_keystore_key_password
